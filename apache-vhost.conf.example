# Contoh vhost Apache untuk Laravel LSP FIT. Salin ke /etc/apache2/sites-available/,
# jangan edit vhost sertifikasifit.com yang sedang aktif sampai cutover.
# Penting: DocumentRoot menunjuk ke public/, bukan ke akar repo.
<VirtualHost *:80>
    ServerName sertifikasifit.com
    ServerAlias www.sertifikasifit.com
    DocumentRoot /var/www/lsp-laravel/public

    <Directory /var/www/lsp-laravel/public>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteRule ^/.well-known/acme-challenge/ - [L]
    RewriteCond %{SERVER_NAME} =sertifikasifit.com [OR]
    RewriteCond %{SERVER_NAME} =www.sertifikasifit.com
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]

    ErrorLog ${APACHE_LOG_DIR}/sertifikasifit.com-error.log
    CustomLog ${APACHE_LOG_DIR}/sertifikasifit.com-access.log combined
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName sertifikasifit.com
    ServerAlias www.sertifikasifit.com
    DocumentRoot /var/www/lsp-laravel/public

    <Directory /var/www/lsp-laravel/public>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/sertifikasifit.com-error.log
    CustomLog ${APACHE_LOG_DIR}/sertifikasifit.com-access.log combined

    SSLCertificateFile /etc/letsencrypt/live/sertifikasifit.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/sertifikasifit.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
